FROM node:24-slim AS builder

RUN npm install -g pnpm@10

WORKDIR /app

# Copy workspace manifests (better layer caching)
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY tsconfig.base.json tsconfig.json ./

# Copy ALL libs (pnpm workspace requires all packages present)
COPY lib/ ./lib/

# Copy ALL artifacts source (pnpm workspace resolution)
COPY artifacts/ ./artifacts/

# Install all dependencies (bcrypt is in onlyBuiltDependencies, compiles automatically)
RUN pnpm install --frozen-lockfile

# Build the API bundle with esbuild
RUN pnpm --filter @workspace/api-server run build

# ---- Runtime stage ----
FROM node:24-slim

WORKDIR /app

# Copy the full node_modules tree (pnpm virtual store + hoisted packages)
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/artifacts/api-server/node_modules ./artifacts/api-server/node_modules

# Copy compiled API bundle into the same location as the source so pnpm resolution works
COPY --from=builder /app/artifacts/api-server/dist ./artifacts/api-server/dist

# Cria pastas de upload
RUN mkdir -p /app/uploads/sliderImages

EXPOSE 3001

ENV NODE_ENV=production

CMD ["node", "--enable-source-maps", "./artifacts/api-server/dist/index.mjs"]
